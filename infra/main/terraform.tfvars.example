aws_region                       = "us-east-1"
artifacts_bucket_name            = "your-project-artifacts-us-east-1"
live_bucket_name                 = "your-project-web-live-us-east-1"
notification_email               = "your-email@example.com"
public_hostname                  = "redlink.example.com"
enable_custom_domain             = false
language                         = "it"
runner_ami_id                    = "ami-0123456789abcdef0"
runner_instance_type             = "t4g.2xlarge"
root_volume_size_gb              = 200
duckdb_memory_limit              = "24GB"
duckdb_threads                   = 4
decompress_workers               = 1
parallel_workers                 = 4
parallel_chunk_insert_lines      = 100
parallel_target_chunk_multiplier = 3
web_batch_size                   = 100000
schedule_expression              = "cron(0 7 * * ? *)"
schedule_timezone                = "Europe/Rome"
state_machine_timeout_seconds    = 43200
monthly_budget_limit_usd         = "30"
